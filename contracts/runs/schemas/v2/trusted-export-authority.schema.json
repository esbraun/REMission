{
  "$defs": {
    "BindingsV2": {
      "additionalProperties": false,
      "properties": {
        "analytic_fixtures": {
          "$ref": "#/$defs/VersionRef"
        },
        "calibration_schema": {
          "$ref": "#/$defs/VersionRef"
        },
        "catalog": {
          "$ref": "#/$defs/VersionRef"
        },
        "dgp": {
          "$ref": "#/$defs/VersionRef"
        },
        "domain_schema_set": {
          "$ref": "#/$defs/VersionRef"
        },
        "equations": {
          "$ref": "#/$defs/VersionRef"
        },
        "observed_representation": {
          "$ref": "#/$defs/VersionRef"
        },
        "parameters": {
          "$ref": "#/$defs/VersionRef"
        },
        "probability_precision": {
          "$ref": "#/$defs/VersionRef"
        },
        "protocol": {
          "$ref": "#/$defs/VersionRef"
        },
        "run_schema_set": {
          "$ref": "#/$defs/VersionRef"
        },
        "scenarios": {
          "$ref": "#/$defs/VersionRef"
        },
        "temporal": {
          "$ref": "#/$defs/VersionRef"
        },
        "timing": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "protocol",
        "dgp",
        "parameters",
        "equations",
        "scenarios",
        "catalog",
        "timing",
        "temporal",
        "calibration_schema",
        "analytic_fixtures",
        "probability_precision",
        "observed_representation",
        "domain_schema_set",
        "run_schema_set"
      ],
      "title": "BindingsV2",
      "type": "object"
    },
    "DecisionSlotV2": {
      "additionalProperties": false,
      "properties": {
        "assessment_at": {
          "format": "date-time",
          "title": "Assessment At",
          "type": "string"
        },
        "decision_at": {
          "format": "date-time",
          "title": "Decision At",
          "type": "string"
        },
        "decision_index": {
          "maximum": 84,
          "minimum": 0,
          "title": "Decision Index",
          "type": "integer"
        },
        "outcome_link_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Outcome Link Id",
          "type": "string"
        },
        "window_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Window Id",
          "type": "string"
        }
      },
      "required": [
        "decision_index",
        "decision_at",
        "window_id",
        "assessment_at",
        "outcome_link_id"
      ],
      "title": "DecisionSlotV2",
      "type": "object"
    },
    "ExactRef": {
      "additionalProperties": false,
      "properties": {
        "payload_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "payload_sha256"
      ],
      "title": "ExactRef",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "generator",
            "evaluator",
            "contract_fixture"
          ],
          "title": "Role",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "role"
      ],
      "title": "Producer",
      "type": "object"
    },
    "RecordIdentityV2": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Cell Id",
          "type": "string"
        },
        "cohort_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Cohort Id",
          "type": "string"
        },
        "draw_consumed": {
          "title": "Draw Consumed",
          "type": "boolean"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "namespace": {
          "enum": [
            "generation",
            "assignment",
            "measurement",
            "missingness",
            "fitting",
            "posterior_rollout",
            "truth"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "patient_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Patient Id",
          "type": "string"
        },
        "phase": {
          "enum": [
            "fixture",
            "calibration",
            "pilot",
            "smoke",
            "development",
            "confirmation"
          ],
          "title": "Phase",
          "type": "string"
        },
        "process": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Process",
          "type": "string"
        },
        "protocol": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Protocol",
          "type": "string"
        },
        "replicate": {
          "minimum": 0,
          "title": "Replicate",
          "type": "integer"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Run Id",
          "type": "string"
        },
        "source_registry": {
          "$ref": "#/$defs/VersionRef"
        },
        "substream": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Substream",
          "type": "string"
        },
        "time_index": {
          "title": "Time Index",
          "type": "integer"
        },
        "transformation": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "protocol",
        "phase",
        "run_id",
        "cell_id",
        "cohort_id",
        "replicate",
        "patient_id",
        "time_index",
        "process",
        "substream",
        "namespace",
        "source_registry",
        "transformation",
        "input_refs",
        "draw_consumed"
      ],
      "title": "RecordIdentityV2",
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "properties": {
        "image_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "numerical_lock": {
          "$ref": "#/$defs/VersionRef"
        },
        "numpy_version": {
          "const": "2.5.4",
          "title": "Numpy Version",
          "type": "string"
        },
        "precision": {
          "const": "float64",
          "title": "Precision",
          "type": "string"
        },
        "prng": {
          "const": "PCG64DXSM",
          "title": "Prng",
          "type": "string"
        },
        "python_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "seed_derivation": {
          "const": "remission-seed-v1",
          "title": "Seed Derivation",
          "type": "string"
        },
        "service_lock": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "image_sha256",
        "numerical_lock",
        "service_lock",
        "python_version",
        "numpy_version",
        "prng",
        "seed_derivation",
        "precision"
      ],
      "title": "Runtime",
      "type": "object"
    },
    "ScheduleInputV2": {
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "$ref": "#/$defs/VersionRef"
        },
        "cell_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Cell Id",
          "type": "string"
        },
        "cohort_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Cohort Id",
          "type": "string"
        },
        "derivation": {
          "$ref": "#/$defs/VersionRef"
        },
        "dgp": {
          "$ref": "#/$defs/VersionRef"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "support_schedule_input",
          "title": "Kind",
          "type": "string"
        },
        "partition_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Partition Id",
          "type": "string"
        },
        "patient_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Patient Id",
          "type": "string"
        },
        "patient_ref": {
          "$ref": "#/$defs/ExactRef"
        },
        "planned_horizon": {
          "const": 84,
          "title": "Planned Horizon",
          "type": "integer"
        },
        "preset": {
          "enum": [
            "catalog_cell",
            "smoke",
            "demonstration",
            "evaluation"
          ],
          "title": "Preset",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/VersionRef"
        },
        "replicate": {
          "minimum": 0,
          "title": "Replicate",
          "type": "integer"
        },
        "representation": {
          "$ref": "#/$defs/VersionRef"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "temporal": {
          "$ref": "#/$defs/VersionRef"
        },
        "time_zero_local_date": {
          "format": "date",
          "title": "Time Zero Local Date",
          "type": "string"
        },
        "time_zero_utc": {
          "format": "date-time",
          "title": "Time Zero Utc",
          "type": "string"
        },
        "timezone": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "timezone_database": {
          "$ref": "#/$defs/VersionRef"
        },
        "timing": {
          "$ref": "#/$defs/VersionRef"
        },
        "unit_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "synthetic",
        "kind",
        "id",
        "run_id",
        "partition_id",
        "protocol",
        "timing",
        "temporal",
        "representation",
        "dgp",
        "catalog",
        "cell_id",
        "preset",
        "unit_id",
        "cohort_id",
        "replicate",
        "patient_id",
        "patient_ref",
        "timezone",
        "time_zero_local_date",
        "time_zero_utc",
        "timezone_database",
        "derivation",
        "planned_horizon"
      ],
      "title": "ScheduleInputV2",
      "type": "object"
    },
    "TrustedPartitionV2": {
      "additionalProperties": false,
      "description": "Derived/qualified externally; an upload cannot redefine these facts.",
      "properties": {
        "completion_receipt_hashes": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "title": "Completion Receipt Hashes",
          "type": "object"
        },
        "coverage_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Coverage Sha256",
          "type": "string"
        },
        "expected_decisions": {
          "items": {
            "$ref": "#/$defs/DecisionSlotV2"
          },
          "title": "Expected Decisions",
          "type": "array"
        },
        "mechanism_hashes": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "title": "Mechanism Hashes",
          "type": "object"
        },
        "partition_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Partition Id",
          "type": "string"
        },
        "record_identities": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$": {
              "$ref": "#/$defs/RecordIdentityV2"
            }
          },
          "title": "Record Identities",
          "type": "object"
        },
        "record_key_hashes": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "title": "Record Key Hashes",
          "type": "object"
        },
        "schedule": {
          "$ref": "#/$defs/ScheduleInputV2"
        },
        "stage_ledger_hashes": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "title": "Stage Ledger Hashes",
          "type": "object"
        },
        "terminal_evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terminal Evidence Sha256"
        }
      },
      "required": [
        "partition_id",
        "schedule",
        "expected_decisions",
        "coverage_sha256",
        "terminal_evidence_sha256",
        "stage_ledger_hashes",
        "completion_receipt_hashes",
        "mechanism_hashes",
        "record_identities",
        "record_key_hashes"
      ],
      "title": "TrustedPartitionV2",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "urn:remission:runs:2.0.0:trusted-export-authority",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_contract_fixture": {
      "title": "Allow Contract Fixture",
      "type": "boolean"
    },
    "bindings": {
      "$ref": "#/$defs/BindingsV2"
    },
    "contract_version": {
      "const": "2.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "export_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "title": "Export Id",
      "type": "string"
    },
    "export_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Export Sha256",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "partitions": {
      "items": {
        "$ref": "#/$defs/TrustedPartitionV2"
      },
      "title": "Partitions",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "producer_qualification": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/Runtime"
    },
    "source_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Source Commit",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "producer",
    "manifest_sha256",
    "source_commit",
    "runtime",
    "allow_contract_fixture",
    "export_id",
    "export_sha256",
    "contract_version",
    "bindings",
    "producer_qualification",
    "partitions"
  ],
  "title": "ExportAuthorityV2",
  "type": "object"
}
