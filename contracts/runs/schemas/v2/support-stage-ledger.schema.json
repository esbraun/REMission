{
  "$defs": {
    "ExactRef": {
      "additionalProperties": false,
      "properties": {
        "payload_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "payload_sha256"
      ],
      "title": "ExactRef",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "urn:remission:runs:2.0.0:support-stage-ledger",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision_index": {
      "maximum": 84,
      "minimum": 0,
      "title": "Decision Index",
      "type": "integer"
    },
    "event_refs": {
      "items": {
        "$ref": "#/$defs/ExactRef"
      },
      "title": "Event Refs",
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "support_stage_ledger",
      "title": "Kind",
      "type": "string"
    },
    "partition_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "title": "Partition Id",
      "type": "string"
    },
    "patient_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Patient Id",
      "type": "string"
    },
    "rule": {
      "$ref": "#/$defs/VersionRef"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "enum": [
        "offered",
        "delivered"
      ],
      "title": "Stage",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "window_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Window Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "kind",
    "id",
    "run_id",
    "partition_id",
    "patient_id",
    "decision_index",
    "window_id",
    "stage",
    "rule",
    "event_refs"
  ],
  "title": "StageLedgerV2",
  "type": "object"
}
