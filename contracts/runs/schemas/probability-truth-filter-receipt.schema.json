{
  "$defs": {
    "StreamKey": {
      "additionalProperties": false,
      "description": "Complete accepted key material; words and digest are verified, not trusted.",
      "properties": {
        "key_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Key Sha256",
          "type": "string"
        },
        "namespace": {
          "enum": [
            "generation",
            "assignment",
            "measurement",
            "missingness",
            "fitting",
            "posterior_rollout",
            "truth"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "patient": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Patient",
          "type": "string"
        },
        "phase": {
          "enum": [
            "fixture",
            "calibration",
            "pilot",
            "smoke",
            "development",
            "confirmation"
          ],
          "title": "Phase",
          "type": "string"
        },
        "process": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Process",
          "type": "string"
        },
        "protocol": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Protocol",
          "type": "string"
        },
        "replicate": {
          "minimum": 0,
          "title": "Replicate",
          "type": "integer"
        },
        "root_seed": {
          "const": 20261020,
          "title": "Root Seed",
          "type": "integer"
        },
        "scenario": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Scenario",
          "type": "string"
        },
        "stream": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Stream",
          "type": "string"
        },
        "time_index": {
          "title": "Time Index",
          "type": "integer"
        },
        "words": {
          "items": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 8,
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "root_seed",
        "protocol",
        "phase",
        "namespace",
        "scenario",
        "replicate",
        "patient",
        "time_index",
        "process",
        "stream",
        "words",
        "key_sha256"
      ],
      "title": "StreamKey",
      "type": "object"
    }
  },
  "$id": "urn:remission:runs:1.0.0:probability-truth-filter-receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ancestry_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Ancestry Sha256",
      "type": "string"
    },
    "filter_index": {
      "exclusiveMaximum": 32,
      "minimum": 0,
      "title": "Filter Index",
      "type": "integer"
    },
    "innovations_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Innovations Sha256",
      "type": "string"
    },
    "key": {
      "$ref": "#/$defs/StreamKey"
    },
    "particles": {
      "enum": [
        1024,
        4096,
        16384,
        65536
      ],
      "title": "Particles",
      "type": "integer"
    },
    "producer_run": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "title": "Producer Run",
      "type": "string"
    },
    "realization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Realization Sha256",
      "type": "string"
    }
  },
  "required": [
    "producer_run",
    "filter_index",
    "particles",
    "key",
    "realization_sha256",
    "ancestry_sha256",
    "innovations_sha256"
  ],
  "title": "TruthFilterReceipt",
  "type": "object"
}
