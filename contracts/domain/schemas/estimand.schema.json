{
  "$defs": {
    "EventStrategy": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "enum": [
            "death",
            "admission",
            "regimen_change",
            "steroid_change",
            "rescue",
            "discontinuation",
            "override"
          ],
          "title": "Event",
          "type": "string"
        },
        "explanation": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "separate_survival_and_conditional_symptoms",
            "separate_admission_and_conditional_symptoms",
            "treatment_policy"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "event",
        "strategy",
        "explanation"
      ],
      "title": "EventStrategy",
      "type": "object"
    },
    "Horizon": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "integer"
        },
        "endpoint_rule": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Endpoint Rule",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/VersionRef"
        },
        "unit": {
          "enum": [
            "days",
            "protocol_blocks",
            "protocol_stages",
            "cohorts"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit",
        "endpoint_rule",
        "protocol"
      ],
      "title": "Horizon",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "urn:remission:domain:1.0.0:estimand",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clinician_blinded": {
      "title": "Clinician Blinded",
      "type": "boolean"
    },
    "comparator": {
      "enum": [
        "MED_A",
        "MED_B",
        "behavioral_continue",
        "behavioral_escalate",
        "support_prompt",
        "no_prompt",
        "usual_care"
      ],
      "title": "Comparator",
      "type": "string"
    },
    "comparator_information": {
      "enum": [
        "same_permitted_history",
        "privileged_oracle_report_only"
      ],
      "title": "Comparator Information",
      "type": "string"
    },
    "comparator_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "comparator_strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "continuation_policy": {
      "$ref": "#/$defs/VersionRef"
    },
    "contrast": {
      "const": "assignment",
      "title": "Contrast",
      "type": "string"
    },
    "direction": {
      "enum": [
        "lower_is_better",
        "higher_is_better",
        "no_overall_order"
      ],
      "title": "Direction",
      "type": "string"
    },
    "earliest_isi_days_after_assignment": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Earliest Isi Days After Assignment"
    },
    "eligibility_rule": {
      "$ref": "#/$defs/VersionRef"
    },
    "estimand_id": {
      "enum": [
        "EST-VISIT",
        "EST-N1",
        "EST-ESC-STAGE",
        "EST-ESC-STRATEGY",
        "EST-MRT",
        "EST-POLICY",
        "EST-INT"
      ],
      "title": "Estimand Id",
      "type": "string"
    },
    "estimand_version": {
      "const": "1.0.0",
      "title": "Estimand Version",
      "type": "string"
    },
    "event_strategies": {
      "items": {
        "$ref": "#/$defs/EventStrategy"
      },
      "maxItems": 7,
      "minItems": 7,
      "title": "Event Strategies",
      "type": "array"
    },
    "history": {
      "const": "available_observed_preassignment_only",
      "title": "History",
      "type": "string"
    },
    "horizon": {
      "$ref": "#/$defs/Horizon"
    },
    "identification_assumptions": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Identification Assumptions",
      "type": "array"
    },
    "intervention": {
      "enum": [
        "MED_A",
        "MED_B",
        "behavioral_continue",
        "behavioral_escalate",
        "support_prompt",
        "no_prompt",
        "usual_care"
      ],
      "title": "Intervention",
      "type": "string"
    },
    "intervention_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "intervention_strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "isi_instrument_version": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Isi Instrument Version"
    },
    "isi_recall_days": {
      "anyOf": [
        {
          "enum": [
            14,
            30
          ],
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Isi Recall Days"
    },
    "kind": {
      "const": "estimand",
      "title": "Kind",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "missing_data_assumptions": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Data Assumptions",
      "type": "array"
    },
    "observation_cutoff": {
      "format": "date-time",
      "title": "Observation Cutoff",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "ISI",
        "daily_sleep_quality",
        "function",
        "proximal_support_reward",
        "policy_value",
        "interruption_vector"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "patient_blinded": {
      "title": "Patient Blinded",
      "type": "boolean"
    },
    "policy_value_target": {
      "anyOf": [
        {
          "enum": [
            "fixed_contextual",
            "complete_cohort_algorithm"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Policy Value Target"
    },
    "population": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Population",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "support_policy": {
      "$ref": "#/$defs/VersionRef"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "time_zero": {
      "format": "date-time",
      "title": "Time Zero",
      "type": "string"
    },
    "unit": {
      "enum": [
        "ISI_points",
        "quality_points",
        "function_points",
        "probability_vector"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "kind",
    "estimand_id",
    "estimand_version",
    "population",
    "eligibility_rule",
    "history",
    "observation_cutoff",
    "time_zero",
    "intervention",
    "comparator",
    "contrast",
    "patient_blinded",
    "clinician_blinded",
    "outcome",
    "unit",
    "direction",
    "horizon",
    "continuation_policy",
    "support_policy",
    "intervention_strategy",
    "comparator_strategy",
    "intervention_policy",
    "comparator_policy",
    "policy_value_target",
    "event_strategies",
    "missing_data_assumptions",
    "identification_assumptions",
    "comparator_information",
    "source_ids",
    "isi_instrument_version",
    "isi_recall_days",
    "earliest_isi_days_after_assignment",
    "limitations"
  ],
  "title": "EstimandContract",
  "type": "object"
}
