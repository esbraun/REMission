{
  "$defs": {
    "Estimated": {
      "additionalProperties": false,
      "properties": {
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "standard_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Standard Error"
        },
        "status": {
          "const": "estimated",
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "enum": [
            "ISI_points",
            "quality_points",
            "function_points",
            "probability",
            "minutes",
            "count"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "status",
        "value",
        "unit",
        "standard_error",
        "interval"
      ],
      "title": "Estimated",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "interval_type": {
          "enum": [
            "credible",
            "confidence",
            "prediction",
            "monte_carlo"
          ],
          "title": "Interval Type",
          "type": "string"
        },
        "level": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Level",
          "type": "number"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper",
        "level",
        "interval_type"
      ],
      "title": "Interval",
      "type": "object"
    },
    "ParameterSpec": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Distribution",
          "type": "string"
        },
        "provenance": {
          "const": "synthetic_engineering",
          "title": "Provenance",
          "type": "string"
        },
        "rationale": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Symbol",
          "type": "string"
        },
        "unit": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "symbol",
        "unit",
        "value",
        "distribution",
        "provenance",
        "rationale"
      ],
      "title": "ParameterSpec",
      "type": "object"
    },
    "SeedKey": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "enum": [
            "fixture",
            "development",
            "confirmation",
            "truth",
            "fit",
            "assignment"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "patient": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Patient",
          "type": "string"
        },
        "process": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Process",
          "type": "string"
        },
        "protocol": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Protocol",
          "type": "string"
        },
        "replicate": {
          "minimum": 0,
          "title": "Replicate",
          "type": "integer"
        },
        "scenario": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Scenario",
          "type": "string"
        },
        "time_index": {
          "title": "Time Index",
          "type": "integer"
        }
      },
      "required": [
        "namespace",
        "protocol",
        "scenario",
        "replicate",
        "patient",
        "time_index",
        "process"
      ],
      "title": "SeedKey",
      "type": "object"
    },
    "SimulatorTruth": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "const": "evaluator_only",
          "title": "Access",
          "type": "string"
        },
        "counterfactuals": {
          "items": {
            "$ref": "#/$defs/TruthResult"
          },
          "title": "Counterfactuals",
          "type": "array"
        },
        "day": {
          "title": "Day",
          "type": "integer"
        },
        "kind": {
          "const": "simulator_truth",
          "title": "Kind",
          "type": "string"
        },
        "latent_states": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$": {
              "type": "number"
            }
          },
          "title": "Latent States",
          "type": "object"
        },
        "patient_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Patient Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "structural_parameters": {
          "items": {
            "$ref": "#/$defs/ParameterSpec"
          },
          "title": "Structural Parameters",
          "type": "array"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "synthetic",
        "kind",
        "access",
        "patient_id",
        "day",
        "latent_states",
        "structural_parameters",
        "counterfactuals"
      ],
      "title": "SimulatorTruth",
      "type": "object"
    },
    "TruthResult": {
      "additionalProperties": false,
      "properties": {
        "dgp": {
          "$ref": "#/$defs/VersionRef"
        },
        "draws": {
          "minimum": 0,
          "title": "Draws",
          "type": "integer"
        },
        "estimand": {
          "$ref": "#/$defs/VersionRef"
        },
        "estimate": {
          "discriminator": {
            "mapping": {
              "abstained": "#/$defs/Unavailable",
              "estimated": "#/$defs/Estimated",
              "failed": "#/$defs/Unavailable",
              "inconclusive": "#/$defs/Unavailable",
              "pending": "#/$defs/Unavailable",
              "prior_only": "#/$defs/Unavailable",
              "undefined": "#/$defs/Unavailable"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Estimated"
            },
            {
              "$ref": "#/$defs/Unavailable"
            }
          ],
          "title": "Estimate"
        },
        "independent_implementation": {
          "$ref": "#/$defs/VersionRef"
        },
        "information_set": {
          "const": "evaluator_only_structural_system",
          "title": "Information Set",
          "type": "string"
        },
        "kind": {
          "const": "truth_result",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "enum": [
            "analytic",
            "enumerated",
            "numerical"
          ],
          "title": "Method",
          "type": "string"
        },
        "numerical_standard_error": {
          "minimum": 0,
          "title": "Numerical Standard Error",
          "type": "number"
        },
        "privileged_information": {
          "const": true,
          "title": "Privileged Information",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "$ref": "#/$defs/SeedKey"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "synthetic",
        "kind",
        "estimand",
        "method",
        "estimate",
        "numerical_standard_error",
        "information_set",
        "privileged_information",
        "dgp",
        "seed",
        "draws",
        "independent_implementation"
      ],
      "title": "TruthResult",
      "type": "object"
    },
    "Unavailable": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "undefined",
            "failed",
            "abstained",
            "pending",
            "inconclusive",
            "prior_only"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "Unavailable",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "urn:remission:domain:1.0.0:evaluator-truth",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/SimulatorTruth"
    },
    {
      "$ref": "#/$defs/TruthResult"
    }
  ]
}
