{
  "$defs": {
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "action_order": {
          "const": "0=no_prompt,1=approved_prompt",
          "title": "Action Order",
          "type": "string"
        },
        "availability_rule": {
          "const": "singleton_deterministic_empty_unavailable",
          "title": "Availability Rule",
          "type": "string"
        },
        "definition_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Definition Sha256",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sealed_at": {
          "format": "date-time",
          "title": "Sealed At",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "version": {
          "const": "1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "synthetic",
        "policy_id",
        "version",
        "sealed_at",
        "action_order",
        "definition_sha256",
        "availability_rule"
      ],
      "title": "Policy",
      "type": "object"
    },
    "TargetRow": {
      "additionalProperties": false,
      "properties": {
        "probabilities": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Probabilities",
          "type": "array"
        },
        "row_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Row Id",
          "type": "string"
        }
      },
      "required": [
        "row_id",
        "probabilities"
      ],
      "title": "TargetRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "roster_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Roster Sha256",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/TargetRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "policy",
    "roster_sha256",
    "rows"
  ],
  "title": "Targets",
  "type": "object"
}
