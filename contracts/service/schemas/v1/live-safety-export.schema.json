{
  "$defs": {
    "ActiveEpisode": {
      "additionalProperties": false,
      "properties": {
        "episode_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Episode Id",
          "type": "string"
        },
        "generation": {
          "exclusiveMinimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "obligation_set_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Obligation Set Sha256",
          "type": "string"
        },
        "trigger_set_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Trigger Set Sha256",
          "type": "string"
        }
      },
      "required": [
        "episode_id",
        "generation",
        "trigger_set_sha256",
        "obligation_set_sha256"
      ],
      "title": "ActiveEpisode",
      "type": "object"
    },
    "FactsArtifact": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "path": {
          "enum": [
            "observed-projection.json",
            "live-hold-facts.json"
          ],
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "count"
      ],
      "title": "FactsArtifact",
      "type": "object"
    },
    "ObservedArtifact": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "kind": {
          "const": "learner_history",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "enum": [
            "observed-projection.json",
            "live-hold-facts.json"
          ],
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "1.0.0",
            "2.0.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "kind",
        "schema_version"
      ],
      "title": "ObservedArtifact",
      "type": "object"
    },
    "ReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "payload_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Receipt Id",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "payload_sha256"
      ],
      "title": "ReceiptRef",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "urn:remission:service:live-safety-export:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_episodes": {
      "items": {
        "$ref": "#/$defs/ActiveEpisode"
      },
      "title": "Active Episodes",
      "type": "array"
    },
    "authority_generation": {
      "exclusiveMinimum": 0,
      "title": "Authority Generation",
      "type": "integer"
    },
    "authority_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authority Sha256",
      "type": "string"
    },
    "baseline_operation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Baseline Operation Id"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "completeness": {
      "enum": [
        "complete_visible_prefix",
        "uninitialized"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "cutoff": {
      "format": "date-time",
      "title": "Cutoff",
      "type": "string"
    },
    "execution": {
      "enum": [
        "synthetic_service",
        "contract_fixture"
      ],
      "title": "Execution",
      "type": "string"
    },
    "export_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Export Id",
      "type": "string"
    },
    "facts": {
      "$ref": "#/$defs/FactsArtifact"
    },
    "independent_hold_status": {
      "enum": [
        "held",
        "not_held",
        "unknown"
      ],
      "title": "Independent Hold Status",
      "type": "string"
    },
    "journal_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Journal Id",
      "type": "string"
    },
    "kind": {
      "const": "live_safety_export",
      "title": "Kind",
      "type": "string"
    },
    "observed_binding": {
      "$ref": "#/$defs/VersionRef"
    },
    "observed_projection": {
      "$ref": "#/$defs/ObservedArtifact"
    },
    "observed_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Observed Source Sha256",
      "type": "string"
    },
    "patient_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Patient Id",
      "type": "string"
    },
    "prefix_chain_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Prefix Chain Sha256",
      "type": "string"
    },
    "publication_receipt_ref": {
      "$ref": "#/$defs/ReceiptRef"
    },
    "review_rules_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Review Rules Sha256",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/VersionRef"
    },
    "schema_binding": {
      "$ref": "#/$defs/VersionRef"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "independent_live_holds",
      "title": "Scope",
      "type": "string"
    },
    "service_contract": {
      "$ref": "#/$defs/VersionRef"
    },
    "service_instance_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Service Instance Id",
      "type": "string"
    },
    "service_producer": {
      "$ref": "#/$defs/VersionRef"
    },
    "snapshot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "through_patient_sequence": {
      "minimum": 0,
      "title": "Through Patient Sequence",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "synthetic",
    "scope",
    "export_id",
    "service_contract",
    "schema_binding",
    "observed_binding",
    "service_instance_id",
    "service_producer",
    "source_commit",
    "runtime",
    "execution",
    "authority_generation",
    "authority_sha256",
    "review_rules_sha256",
    "patient_id",
    "cutoff",
    "captured_at",
    "snapshot_id",
    "snapshot_sha256",
    "observed_source_sha256",
    "observed_projection",
    "facts",
    "journal_id",
    "baseline_operation_id",
    "through_patient_sequence",
    "prefix_chain_sha256",
    "completeness",
    "independent_hold_status",
    "active_episodes",
    "publication_receipt_ref"
  ],
  "title": "LiveSafetyExport",
  "type": "object"
}
