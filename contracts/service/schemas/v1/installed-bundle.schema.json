{
  "$defs": {
    "ControlBinding": {
      "additionalProperties": false,
      "properties": {
        "activation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Activation Id",
          "type": "string"
        },
        "authority_generation": {
          "exclusiveMinimum": 0,
          "title": "Authority Generation",
          "type": "integer"
        },
        "authority_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Authority Sha256",
          "type": "string"
        },
        "capability": {
          "const": "LIVE-HOLD-01/1.0.0",
          "title": "Capability",
          "type": "string"
        },
        "database_instance_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Database Instance Id",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "minimum_reader_writer_capability": {
          "const": "LIVE-HOLD-01/1.0.0",
          "title": "Minimum Reader Writer Capability",
          "type": "string"
        },
        "review_rules_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Review Rules Sha256",
          "type": "string"
        }
      },
      "required": [
        "database_instance_id",
        "capability",
        "minimum_reader_writer_capability",
        "authority_generation",
        "authority_sha256",
        "review_rules_sha256",
        "enabled",
        "activation_id"
      ],
      "title": "ControlBinding",
      "type": "object"
    },
    "ExactRef": {
      "additionalProperties": false,
      "properties": {
        "payload_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "payload_sha256"
      ],
      "title": "ExactRef",
      "type": "object"
    },
    "FollowUpAmendment": {
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "$ref": "#/$defs/VersionRef"
        },
        "episode_generation": {
          "exclusiveMinimum": 0,
          "title": "Episode Generation",
          "type": "integer"
        },
        "episode_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Episode Id",
          "type": "string"
        },
        "follow_up": {
          "$ref": "#/$defs/FollowUpBinding"
        },
        "grant": {
          "$ref": "#/$defs/SourceGrant"
        },
        "owner_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Owner Id",
          "type": "string"
        },
        "prior_authority_generation": {
          "exclusiveMinimum": 0,
          "title": "Prior Authority Generation",
          "type": "integer"
        },
        "prior_authority_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prior Authority Sha256",
          "type": "string"
        },
        "prior_obligation_set_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prior Obligation Set Sha256",
          "type": "string"
        },
        "prior_review_rules_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prior Review Rules Sha256",
          "type": "string"
        },
        "prior_trigger_set_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prior Trigger Set Sha256",
          "type": "string"
        },
        "service_patient_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Service Patient Id",
          "type": "string"
        },
        "source_bundle_ref": {
          "$ref": "#/$defs/ExactRef"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_key": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
              "type": "string"
            },
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
              "type": "string"
            },
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
              "type": "string"
            },
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
              "type": "string"
            }
          ],
          "title": "Source Key",
          "type": "array"
        },
        "source_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "service_patient_id",
        "episode_id",
        "episode_generation",
        "prior_authority_generation",
        "prior_authority_sha256",
        "prior_review_rules_sha256",
        "prior_trigger_set_sha256",
        "prior_obligation_set_sha256",
        "source_key",
        "source_id",
        "source_version",
        "owner_id",
        "grant",
        "source_bundle_ref",
        "follow_up",
        "authorization"
      ],
      "title": "FollowUpAmendment",
      "type": "object"
    },
    "FollowUpBinding": {
      "additionalProperties": false,
      "properties": {
        "due_at": {
          "format": "date-time",
          "title": "Due At",
          "type": "string"
        },
        "escalation_destination": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Escalation Destination",
          "type": "string"
        },
        "owner_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Owner Id",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/VersionRef"
        },
        "reference": {
          "$ref": "#/$defs/ExactRef"
        }
      },
      "required": [
        "reference",
        "owner_id",
        "policy",
        "due_at",
        "escalation_destination"
      ],
      "title": "FollowUpBinding",
      "type": "object"
    },
    "LiveHoldAuthority": {
      "additionalProperties": false,
      "properties": {
        "archive_verifier": {
          "$ref": "#/$defs/VersionRef"
        },
        "authority_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Authority Id",
          "type": "string"
        },
        "contract": {
          "const": "LIVE-HOLD-01",
          "title": "Contract",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "execution": {
          "enum": [
            "synthetic_service",
            "contract_fixture"
          ],
          "title": "Execution",
          "type": "string"
        },
        "follow_up_amendments": {
          "items": {
            "$ref": "#/$defs/FollowUpAmendment"
          },
          "title": "Follow Up Amendments",
          "type": "array"
        },
        "grants": {
          "items": {
            "$ref": "#/$defs/SourceGrant"
          },
          "title": "Grants",
          "type": "array"
        },
        "observed_binding": {
          "$ref": "#/$defs/VersionRef"
        },
        "producer": {
          "$ref": "#/$defs/VersionRef"
        },
        "schema_binding": {
          "$ref": "#/$defs/VersionRef"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "service_contract": {
          "$ref": "#/$defs/VersionRef"
        },
        "source_registry": {
          "$ref": "#/$defs/VersionRef"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "schema_version",
        "contract",
        "synthetic",
        "authority_id",
        "version",
        "service_contract",
        "schema_binding",
        "enabled",
        "observed_binding",
        "archive_verifier",
        "producer",
        "source_registry",
        "execution",
        "grants",
        "follow_up_amendments"
      ],
      "title": "LiveHoldAuthority",
      "type": "object"
    },
    "ManualReviewRule": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/VersionRef"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        },
        "trigger_rule": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "ref",
        "trigger_rule",
        "requirements"
      ],
      "title": "ManualReviewRule",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/VersionRef"
        },
        "evidence_kinds": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Kinds",
          "type": "array"
        },
        "requirement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "responsible_role": {
          "const": "doctor",
          "title": "Responsible Role",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "requirement_id",
        "definition",
        "responsible_role",
        "evidence_kinds",
        "source_ids"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "ReviewRules": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "LIVE-HOLD-01",
          "title": "Contract",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/ManualReviewRule"
          },
          "title": "Rules",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "contract",
        "synthetic",
        "rules"
      ],
      "title": "ReviewRules",
      "type": "object"
    },
    "SourceGrant": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "allowed_operations": {
          "items": {
            "const": "invalidate",
            "type": "string"
          },
          "title": "Allowed Operations",
          "type": "array"
        },
        "archive_authority_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Archive Authority Sha256",
          "type": "string"
        },
        "archive_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Archive Id",
          "type": "string"
        },
        "archive_patient_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Archive Patient Id",
          "type": "string"
        },
        "episode_namespace": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Episode Namespace",
          "type": "string"
        },
        "ownership_ref": {
          "$ref": "#/$defs/ExactRef"
        },
        "package_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Package Sha256",
          "type": "string"
        },
        "partition_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Partition Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "service_patient_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Service Patient Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "trigger_bindings": {
          "items": {
            "$ref": "#/$defs/TriggerBinding"
          },
          "minItems": 1,
          "title": "Trigger Bindings",
          "type": "array"
        }
      },
      "required": [
        "account_id",
        "service_patient_id",
        "archive_patient_id",
        "source_id",
        "source_version",
        "run_id",
        "partition_id",
        "archive_id",
        "package_sha256",
        "archive_authority_sha256",
        "ownership_ref",
        "episode_namespace",
        "allowed_operations",
        "trigger_bindings"
      ],
      "title": "SourceGrant",
      "type": "object"
    },
    "TriggerBinding": {
      "additionalProperties": false,
      "properties": {
        "follow_ups": {
          "items": {
            "$ref": "#/$defs/FollowUpBinding"
          },
          "minItems": 1,
          "title": "Follow Ups",
          "type": "array"
        },
        "required_reviews": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "minItems": 1,
          "title": "Required Reviews",
          "type": "array"
        },
        "trigger_rule": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "trigger_rule",
        "required_reviews",
        "follow_ups"
      ],
      "title": "TriggerBinding",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "urn:remission:service:installed-bundle:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "$ref": "#/$defs/LiveHoldAuthority"
    },
    "control": {
      "$ref": "#/$defs/ControlBinding"
    },
    "review_rules": {
      "$ref": "#/$defs/ReviewRules"
    }
  },
  "required": [
    "control",
    "authority",
    "review_rules"
  ],
  "title": "InstalledBundle",
  "type": "object"
}
