+    experiment: VersionRef
+    planned_cohort: VersionRef
+    input: VersionRef
+    result: VersionRef
+    artifact_manifest: VersionRef
+    scalar_semantics: Literal['accepted_chain_draw_expected_effect_mean']
+    admission_reference: VersionRef
+
+
