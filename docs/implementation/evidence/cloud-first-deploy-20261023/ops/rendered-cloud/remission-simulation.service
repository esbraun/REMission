[Unit]
Description=REMission single-writer synthetic physician simulation
Requires=docker.service srv-remission.mount
BindsTo=srv-remission.mount
After=docker.service srv-remission.mount network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/remission

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/remission-simulation
ExecStartPre=/usr/bin/python3 /opt/remission-simulation/disk_guard.py
ExecStart=/usr/bin/docker compose --project-name remission-simulation --file /opt/remission-simulation/compose.json up --detach --pull never --scale app=1 --wait --wait-timeout 120
ExecStopPost=/usr/bin/docker compose --project-name remission-simulation --file /opt/remission-simulation/compose.json down --timeout 30
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
