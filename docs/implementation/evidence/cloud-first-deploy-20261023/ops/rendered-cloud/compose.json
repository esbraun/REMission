{
  "name": "remission-simulation",
  "services": {
    "generator": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=128m"
      ],
      "restart": "on-failure:5",
      "pids_limit": 256,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "us-central1-docker.pkg.dev/remission-poc-esbraun/remission/simulation-generator@sha256:d64907d76a2810d2e6cad8acaa012f3df132ced69bfe2636c7eb07f7090b4eee",
      "user": "20000:20000",
      "networks": [
        "private"
      ],
      "mem_limit": "2g",
      "cpus": 2
    },
    "app": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=128m"
      ],
      "restart": "on-failure:5",
      "pids_limit": 256,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "us-central1-docker.pkg.dev/remission-poc-esbraun/remission/simulation-app@sha256:a950cdb0dd9b3bbdeb176c6da71903180406a9bf2160ea3d23faf4be3c0f5e72",
      "user": "10001:10001",
      "networks": [
        "private"
      ],
      "mem_limit": "2g",
      "cpus": 2,
      "environment": {
        "REMISSION_DATABASE": "/data/remission.sqlite",
        "REMISSION_CONTROL_BUNDLE": "/fixtures/bundle.json",
        "REMISSION_RUNTIME_REF": "/fixtures/runtime.json",
        "REMISSION_LIVE_EXPORT_ROOT": "/exports",
        "REMISSION_SOURCE_COMMIT": "286aa87a10a24ad9925c90be033e7d8c0570d99b",
        "REMISSION_ORIGIN": "https://34.59.176.42",
        "REMISSION_GENERATOR_URL": "http://generator:8780"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/srv/remission/data",
          "target": "/data",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/srv/remission/bootstrap",
          "target": "/fixtures",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/srv/remission/exports",
          "target": "/exports",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "depends_on": {
        "generator": {
          "condition": "service_started"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/health',timeout=3).read()"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 6,
        "start_period": "20s"
      }
    },
    "proxy": {
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=128m"
      ],
      "restart": "on-failure:5",
      "pids_limit": 256,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "docker.io/library/caddy@sha256:04913b1da43339a40ad1ea87827d70a576ac5aa6cf674c6e24fdca675887533a",
      "user": "0:0",
      "cap_add": [
        "NET_BIND_SERVICE"
      ],
      "networks": [
        "private",
        "edge"
      ],
      "ports": [
        "80:80",
        "443:443"
      ],
      "mem_limit": "256m",
      "cpus": 1,
      "volumes": [
        {
          "type": "bind",
          "source": "/opt/remission-simulation/Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/srv/remission/proxy-data",
          "target": "/data",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "/srv/remission/proxy-config",
          "target": "/config",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "depends_on": {
        "app": {
          "condition": "service_healthy"
        }
      }
    }
  },
  "networks": {
    "private": {
      "internal": true
    },
    "edge": {}
  }
}
