        (EVIDENCE/"stack-commands.json").write_text(json.dumps(records,indent=2)+"\n",encoding="utf-8")
        if check and result.returncode:raise RuntimeError(result.stderr+result.stdout)
        return result
    service="remission-foundation-service:review3179";learner="remission-foundation-learner:review3179";evaluator="remission-foundation-evaluator:review3179";runtime="remission-foundation-runtime:review3179"
    for role in ([] if args.skip_build else ["learner","evaluator"]):
        run(["docker","build","--file",f"tooling/foundation/{role}.Dockerfile","--tag",f"remission-foundation-{role}:review3179","."])
