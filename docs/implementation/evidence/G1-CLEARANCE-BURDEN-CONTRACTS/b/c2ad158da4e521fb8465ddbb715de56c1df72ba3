"""Independent source identities and finite arithmetic only; no project imports."""
import base64, hashlib, itertools, json, math, subprocess
from fractions import Fraction as F
from pathlib import Path

ROOT=Path(__file__).resolve().parents[1]
OUT=ROOT/'.review-artifacts'
BASE='ec18cb4020ba239710a3fd615e365d5cd72b4d80'
HEAD='5409d54f570040b435a729769ba2d9353b7daffb'
PK='docs/implementation/evidence/G1-CLEARANCE-BURDEN-PLAN-20261021/R1/'
def git(*args, data=None):
    return subprocess.check_output(['git',*args],cwd=ROOT,input=data)
def blob(oid): return git('cat-file','blob',oid)
def ident(raw):
    oid=git('hash-object','-w','--stdin',data=raw).decode().strip()
    assert blob(oid)==raw
    return dict(blob=oid,bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def obj(path): return json.loads(git('show',HEAD+':'+path))
assert git('rev-parse','HEAD').decode().strip()==HEAD
assert git('merge-base','HEAD',BASE).decode().strip()==BASE
assert Path(git('rev-parse','--show-toplevel').decode().strip()).resolve()==ROOT.resolve()
records=[]
for x in obj(PK+'source-identities.json'):
    raw=git('show',x['base']+':'+x['path']); d=ident(raw)
    assert d['blob']==x['git_blob'] and d['bytes']==x['git_bytes'] and d['sha256']==x['sha256']
    records.append(dict(path=x['path'],base=x['base'],**d))
manifest=obj(PK+'artifact-manifest.json')
artifacts=[]
for x in manifest['artifacts']:
    raw=git('show',HEAD+':'+x['path']); d=ident(raw)
    assert d['blob']==x['raw_git_blob'] and d['bytes']==x['bytes'] and d['sha256']==x['sha256']
    artifacts.append(dict(path=x['path'],**d))
preserved=[]
(OUT/'inputs').mkdir(exist_ok=True)
for x in obj(PK+'preserved-inputs.json')['items']:
    raw=base64.b64decode(x['base64'],validate=True);d=ident(raw)
    assert d['blob']==x['git_blob'] and d['bytes']==x['bytes'] and d['sha256']==x['sha256']
    (OUT/'inputs'/d['blob']).write_bytes(raw)
    preserved.append(dict(label=x['label'],**d))
for x in manifest['original_paths_verified']:
    assert git('show',HEAD+':'+x['path'])==blob(x['raw_git_blob'])
logs=[]
for x in obj(PK+'whitespace-log-recovery.json')['items']:
    d=ident(base64.b64decode(x['base64'],validate=True));assert d['blob']==x['raw_git_blob'] and d['bytes']==x['bytes'];logs.append(d)
whole=subprocess.run(['git','diff','--check',BASE,HEAD],cwd=ROOT,capture_output=True)
(OUT/'whole-diff.stdout').write_bytes(whole.stdout);(OUT/'whole-diff.stderr').write_bytes(whole.stderr)
assert whole.returncode==2
assert whole.stdout.decode().count('trailing whitespace.')==2 and whole.stdout.decode().count('new blank line at EOF.')==1
scoped=subprocess.run(['git','diff','--check',BASE,HEAD,'--',PK,'docs/implementation/g1-clearance-burden-contract-proposal-r1-20261021.md'],cwd=ROOT,capture_output=True)
assert scoped.returncode==0 and not scoped.stdout and not scoped.stderr
cells=json.loads(git('show',BASE+':contracts/dgp/scenarios-v1.json'))['cells']; bindings=obj(PK+'cell-law-bindings.json')['ordered_cells']
assert len(cells)==len(bindings)==82
for c,b in zip(cells,bindings):
    assert c['id']==b['cell_id'] and c['patients']==b['patients'] and c['overrides']==b['original_overrides']
    assert b['concern_script']=='CONCERN-EMPTY-01' and b['regimen_ack']=='REGIMEN-ACK-01'
assert len({(c['family'],c['variant']) for c in cells})==73 and len({c['family'] for c in cells})==32
def inv(n,q):
    if not q:return None
    probabilities=[F(math.comb(n,m))*q**m*(1-q)**(n-m) for m in range(1,n+1)]
    return sum(p/F(m) for m,p in enumerate(probabilities,1))/sum(probabilities)
rows=list(itertools.product([None,None,None,0,4],repeat=3));defined=[[v for v in r if v is not None] for r in rows];defined=[r for r in defined if r]
means=[F(sum(r),len(r)) for r in defined];cats=[F(r.count(4),len(r)) for r in defined]
assert len(rows)==125 and len(defined)==98 and inv(3,F(2,5))==F(16,21)
assert sum((v-2)**2 for v in means)/98==F(64,21)
assert sum((v-F(1,2))**2 for v in cats)/98==F(4,21)
assert 8*sum(v==0 for v in cats)==296
assert inv(1,F(1,1000000))==1 and inv(30,F(1))==F(1,30) and inv(30,F(0)) is None
assert inv(3,F(1,1000000))>F(999,1000)
for n in (1,3,30,120):
    values=[inv(n,F(i,20)) for i in range(1,21)]
    assert all(a>=b for a,b in zip(values,values[1:]))
instrument=[]
for n in (0,2,3):
    p=F(1,4)+F(n,20);pmf=[F(math.comb(4,k))*p**k*(1-p)**(4-k) for k in range(5)]
    assert sum(pmf)==1 and sum(k*pmf[k] for k in range(5))==4*p
    assert sum(pmf[3:])==4*p**3-3*p**4
    instrument.append(dict(N=n,mean=str(4*p),variance=str(4*p*(1-p)),tail=str(sum(pmf[3:]))))
result=dict(head=HEAD,base=BASE,sources=records,artifacts=artifacts,preserved=preserved,recovered_logs=logs,
            author_manifest=ident(blob('9e6c7ae7e6253229809a8ff5122ad5b719cc7244')),
            checks=dict(source_count=len(records),new_artifacts=len(artifacts),preserved_count=len(preserved),cells=82,variants=73,families=32,
                        microstates=125,undefined=27,r='16/21',category_variance='4/21',score_variance='64/21',
                        instrument=instrument,monotonicity_grid=True,endpoint_checks=True,scoped_diff=0,whole_diff=2),
            scope='Finite arithmetic and source preservation only; no engine/runtime/pilot acceptance')
(OUT/'source-checks.json').write_text(json.dumps(result,indent=2)+'\n',encoding='utf-8')
print(json.dumps(result['checks'],indent=2))
