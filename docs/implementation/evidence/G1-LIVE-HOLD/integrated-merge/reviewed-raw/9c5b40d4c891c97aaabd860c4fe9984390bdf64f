def git(*args, check=True):
    p = subprocess.run(["git", *args], cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if check and p.returncode:
        raise RuntimeError(f"git {' '.join(args)} failed rc={p.returncode}: {p.stderr.decode(errors='replace')}")
    return p

def blob(rev, path):
    p = git("rev-parse", f"{rev}:{path}", check=False)
    if p.returncode: return None, None
    oid = p.stdout.decode().strip()
    return oid, git("cat-file", "blob", oid).stdout

