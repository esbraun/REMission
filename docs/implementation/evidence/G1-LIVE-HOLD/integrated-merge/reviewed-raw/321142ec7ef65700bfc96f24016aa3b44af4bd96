import unittest,json,copy
from test_live_hold import LiveWorkflowTests
class ClearanceRetry(LiveWorkflowTests):
 def runTest(self):
  first=self.enter();e=self.client.get('/api/patients/SYN-02/live-holds').json()['episodes'][0];url='/api/patients/SYN-02/live-holds/'+first['episode_id'];review_request=self.review_input(e)
  review=self.client.post(url+'/reviews',json=review_request,headers=self.headers('review'));self.assertEqual(review.status_code,200,review.text)
  clear=self.review_input(e)
  for k in ['items','rationale','current_assessment_attested']:clear.pop(k)
  clear.update(review_id=review.json()['review_id'],review_sha256=review.json()['review_sha256'])
  result=self.client.post(url+'/clearance',json=clear,headers=self.headers('clear'));self.assertEqual(result.status_code,200,result.text);before=self.safety_state();self.restart_client()
  for path,body,key,expected in [('/clearance',clear,'clear',result.json()),('/clearance',clear,'clear-alias',result.json()),('/reviews',review_request,'review-alias-after-clearance',review.json())]:
   r=self.client.post(url+path,json=body,headers=self.headers(key));self.assertEqual(r.status_code,200,r.text);self.assertEqual(r.json(),expected)
  after=self.safety_state();self.assertEqual(len(after['live_hold_keys']),len(before['live_hold_keys'])+2);self.assertEqual({k:v for k,v in before.items() if k!='live_hold_keys'},{k:v for k,v in after.items() if k!='live_hold_keys'})
  self.assertEqual(self.client.get('/api/patients/SYN-02').json()['stage'],'ASSIGN-01')
  self.install_next(self.settings.installed.authority.model_copy(update={'grants':[]}));self.restart_client();before=self.safety_state()
  for path,body,key in [('/clearance',clear,'clear'),('/clearance',clear,'revoked-clear-alias'),('/reviews',review_request,'review'),('/reviews',review_request,'revoked-review-alias')]:
   r=self.client.post(url+path,json=body,headers=self.headers(key));self.assertEqual(r.status_code,409,r.text);self.assertEqual(r.json()['code'],'live_source_grant_unavailable')
  self.assertEqual(before,self.safety_state());print('clearance and review after-clearance retries: original receipts; exactly two aliases, no state effects; revoked same/new keys refused without effects',flush=True)
raise SystemExit(not unittest.TextTestRunner(verbosity=2).run(unittest.TestSuite([ClearanceRetry()])).wasSuccessful())
