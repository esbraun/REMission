    "patient_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Patient Id",
      "type": "string"
    },
    "patient_ref": {
      "$ref": "#/$defs/ExactRef"
    },
    "planned_horizon": {
      "const": 84,
      "title": "Planned Horizon",
      "type": "integer"
    },
    "preset": {
      "enum": [
        "catalog_cell",
        "smoke",
        "demonstration",
        "evaluation"
