      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/VersionRef"
    },
    "replicate": {
      "minimum": 0,
      "title": "Replicate",
      "type": "integer"
    },
    "representation": {
      "$ref": "#/$defs/VersionRef"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
