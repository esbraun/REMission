{
  "$defs": {
    "ExactRef": {
      "additionalProperties": false,
      "properties": {
        "payload_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "payload_sha256"
      ],
      "title": "ExactRef",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "urn:remission:runs:2.0.0:support-schedule-input",
