    "catalog": {
      "$ref": "#/$defs/VersionRef"
    },
    "cell_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Cell Id",
      "type": "string"
    },
    "cohort_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "title": "Cohort Id",
      "type": "string"
    },
    "derivation": {
      "$ref": "#/$defs/VersionRef"
    },
    "dgp": {
      "$ref": "#/$defs/VersionRef"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "support_schedule_input",
      "title": "Kind",
      "type": "string"
    },
    "partition_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
