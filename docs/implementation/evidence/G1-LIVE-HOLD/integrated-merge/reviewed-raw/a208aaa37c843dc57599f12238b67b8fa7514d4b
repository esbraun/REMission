{
  "$defs": {
    "Estimated": {
      "additionalProperties": false,
      "properties": {
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "standard_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Standard Error"
        },
        "status": {
          "const": "estimated",
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "enum": [
            "ISI_points",
            "quality_points",
            "function_points",
            "probability",
            "minutes",
            "count"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "status",
        "value",
        "unit",
        "standard_error",
        "interval"
      ],
      "title": "Estimated",
      "type": "object"
    },
    "FitMetadata": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "const": "pymc",
          "title": "Backend",
          "type": "string"
        },
        "backend_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Backend Version",
          "type": "string"
        },
        "diagnostics_artifacts": {
          "items": {
            "$ref": "#/$defs/VersionRef"
          },
          "title": "Diagnostics Artifacts",
          "type": "array"
        },
        "failure_reason": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Reason"
        },
        "packages": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Packages",
          "type": "object"
        },
        "precision": {
          "const": "float64",
          "title": "Precision",
          "type": "string"
        },
        "sampler": {
          "const": "native_nuts",
          "title": "Sampler",
          "type": "string"
        },
        "sampler_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Sampler Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "failed",
            "abstained",
            "pending"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "backend_version",
        "sampler",
        "sampler_version",
        "packages",
        "precision",
        "status",
        "diagnostics_artifacts",
        "failure_reason"
      ],
      "title": "FitMetadata",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "interval_type": {
          "enum": [
            "credible",
            "confidence",
            "prediction",
            "monte_carlo"
          ],
          "title": "Interval Type",
          "type": "string"
        },
        "level": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Level",
          "type": "number"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper",
        "level",
        "interval_type"
      ],
      "title": "Interval",
      "type": "object"
    },
    "SeedKey": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "enum": [
            "fixture",
            "development",
            "confirmation",
            "truth",
            "fit",
            "assignment"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "patient": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Patient",
          "type": "string"
        },
        "process": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Process",
          "type": "string"
        },
        "protocol": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Protocol",
          "type": "string"
        },
        "replicate": {
          "minimum": 0,
          "title": "Replicate",
          "type": "integer"
        },
        "scenario": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Scenario",
          "type": "string"
        },
        "time_index": {
          "title": "Time Index",
          "type": "integer"
        }
      },
      "required": [
        "namespace",
        "protocol",
        "scenario",
        "replicate",
        "patient",
        "time_index",
        "process"
      ],
      "title": "SeedKey",
      "type": "object"
    },
    "Unavailable": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "undefined",
            "failed",
            "abstained",
            "pending",
            "inconclusive",
            "prior_only"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "Unavailable",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "urn:remission:domain:1.0.0:replicate-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
        "type": "string"
      },
      "title": "Assignment Refs",
      "type": "array"
    },
    "attempted_fit": {
      "title": "Attempted Fit",
      "type": "boolean"
    },
    "estimate": {
      "discriminator": {
        "mapping": {
          "abstained": "#/$defs/Unavailable",
          "estimated": "#/$defs/Estimated",
          "failed": "#/$defs/Unavailable",
          "inconclusive": "#/$defs/Unavailable",
          "pending": "#/$defs/Unavailable",
          "prior_only": "#/$defs/Unavailable",
          "undefined": "#/$defs/Unavailable"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Estimated"
        },
        {
          "$ref": "#/$defs/Unavailable"
        }
      ],
      "title": "Estimate"
    },
    "executed_propensities": {
      "items": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "title": "Executed Propensities",
      "type": "array"
    },
    "execution_seconds": {
      "minimum": 0,
      "title": "Execution Seconds",
      "type": "number"
    },
    "failure_reason": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Failure Reason"
    },
    "fit": {
      "anyOf": [
        {
          "$ref": "#/$defs/FitMetadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_versions": {
      "items": {
        "$ref": "#/$defs/VersionRef"
      },
      "minItems": 1,
      "title": "Input Versions",
      "type": "array"
    },
    "kind": {
      "const": "replicate_result",
      "title": "Kind",
      "type": "string"
    },
    "outcome_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
        "type": "string"
      },
      "title": "Outcome Refs",
      "type": "array"
    },
    "peak_memory_bytes": {
      "minimum": 0,
      "title": "Peak Memory Bytes",
      "type": "integer"
    },
    "replicate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Replicate Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seeds": {
      "items": {
        "$ref": "#/$defs/SeedKey"
      },
      "minItems": 1,
      "title": "Seeds",
      "type": "array"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "truth_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "violations": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Violations",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "kind",
    "run_id",
    "replicate_id",
    "input_versions",
    "seeds",
    "attempted_fit",
    "fit",
    "estimate",
    "truth_ref",
    "assignment_refs",
    "executed_propensities",
    "outcome_refs",
    "violations",
    "execution_seconds",
    "peak_memory_bytes",
    "failure_reason"
  ],
  "title": "ReplicateResult",
  "type": "object"
}
