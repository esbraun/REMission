{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "exclusiveMinimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "application/json",
            "text/markdown",
            "text/plain"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "configuration",
            "observed",
            "replay",
            "observed_manifest",
            "private_truth",
            "seed_ledger",
            "calibration",
            "evaluator_request",
            "evaluator_result",
            "run_manifest"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "bytes",
        "role",
        "media_type"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "CalibrationBinding": {
      "additionalProperties": false,
      "properties": {
        "achieved": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Achieved"
        },
        "achieved_mcse": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Achieved Mcse"
        },
        "calibration_sample_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Calibration Sample Sha256",
          "type": "string"
        },
        "cell_id": {
          "title": "Cell Id",
          "type": "string"
        },
        "coefficient": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coefficient"
        },
        "dgp": {
          "$ref": "#/$defs/VersionRef"
        },
        "frozen_before": {
          "const": "development_and_confirmation",
          "title": "Frozen Before",
          "type": "string"
        },
        "iterations": {
          "maximum": 100,
          "minimum": 0,
          "title": "Iterations",
          "type": "integer"
        },
        "purpose": {
          "enum": [
            "report_rate",
            "event_rate",
            "external_contrast"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "sample_size": {
          "exclusiveMinimum": 0,
          "title": "Sample Size",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed_key_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Seed Key Sha256",
          "type": "string"
        },
        "smallest_estimator_se": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Smallest Estimator Se"
        },
        "source_pilot": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_se": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Se"
        },
        "source_se_mcse": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Se Mcse"
        },
        "status": {
          "enum": [
            "solved",
            "infeasible",
            "inconclusive"
          ],
          "title": "Status",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "target": {
          "title": "Target",
          "type": "number"
        },
        "target_spec": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "schema_version",
        "synthetic",
        "purpose",
        "status",
        "dgp",
        "cell_id",
        "target_spec",
        "calibration_sample_sha256",
        "seed_key_sha256",
        "sample_size",
        "target",
        "achieved",
        "achieved_mcse",
        "coefficient",
        "iterations",
        "source_se",
        "source_se_mcse",
        "source_pilot",
        "source_reference",
        "smallest_estimator_se",
        "frozen_before"
      ],
      "title": "CalibrationBinding",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "generator",
            "evaluator",
            "contract_fixture"
          ],
          "title": "Role",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "role"
      ],
      "title": "Producer",
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "properties": {
        "image_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "numerical_lock": {
          "$ref": "#/$defs/VersionRef"
        },
        "numpy_version": {
          "const": "2.5.4",
          "title": "Numpy Version",
          "type": "string"
        },
        "precision": {
          "const": "float64",
          "title": "Precision",
          "type": "string"
        },
        "prng": {
          "const": "PCG64DXSM",
          "title": "Prng",
          "type": "string"
        },
        "python_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "seed_derivation": {
          "const": "remission-seed-v1",
          "title": "Seed Derivation",
          "type": "string"
        },
        "service_lock": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "image_sha256",
        "numerical_lock",
        "service_lock",
        "python_version",
        "numpy_version",
        "prng",
        "seed_derivation",
        "precision"
      ],
      "title": "Runtime",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "urn:remission:runs:1.0.0:calibration-artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/CalibrationBinding"
    },
    "comparator_pilots": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Comparator Pilots",
      "type": "array"
    },
    "contract_version": {
      "const": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "execution": {
      "enum": [
        "contract_fixture",
        "engine_run"
      ],
      "title": "Execution",
      "type": "string"
    },
    "kind": {
      "const": "calibration_artifact",
      "title": "Kind",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "title": "Run Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/Runtime"
    },
    "sample": {
      "$ref": "#/$defs/Artifact"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seeds": {
      "$ref": "#/$defs/Artifact"
    },
    "source_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "source_pilot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/Artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "kind",
    "contract_version",
    "run_id",
    "producer",
    "execution",
    "source_commit",
    "runtime",
    "binding",
    "sample",
    "seeds",
    "source_reference",
    "source_pilot",
    "comparator_pilots"
  ],
  "title": "CalibrationArtifact",
  "type": "object"
}
