def git(*args, check=True):
    p = subprocess.run(['git', *args], cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if check and p.returncode:
        msg = f'git {args!r}: rc={p.returncode}; {p.stderr.decode(errors="replace")}'
        FAILURES.append(msg)
        raise RuntimeError(msg)
    return p

def blob(rev, path):
    p = git('rev-parse', f'{rev}:{path}', check=False)
    if p.returncode:
        return None, None
    oid = p.stdout.decode().strip()
    return oid, git('cat-file', 'blob', oid).stdout

def obj(oid): return git('cat-file', 'blob', oid).stdout
def sha(data): return hashlib.sha256(data).hexdigest()
def parse(data): return json.loads(data.decode('utf-8'))
def ids(rows, key): return [x.get(key) for x in rows]
def changed_paths(a, b, prefix=''):
    if isinstance(a, dict) and isinstance(b, dict):
        out=[]
        for k in sorted(set(a)|set(b)):
            p=f'{prefix}.{k}' if prefix else k
            if k not in a or k not in b: out.append(p)
            else: out.extend(changed_paths(a[k],b[k],p))
        return out
    if isinstance(a, list) and isinstance(b, list): return [] if a == b else [prefix]
    return [] if a == b else [prefix]

def ref_inventory(doc):
    tasks, coverage = doc.get('tasks', []), doc.get('coverage', [])
    task_ids={x.get('id') for x in tasks}; req_ids={x.get('requirement_id') for x in coverage}
    test_ids={x for t in tasks for x in t.get('test_ids',[])} | {x for c in coverage for x in c.get('test_ids',[])}
    deps=[]; dep_bad=[]; task_tests=[]; task_reqs=[]; cov_tasks=[]; cov_tests=[]; cov_task_bad=[]; cov_test_bad=[]
    for t in tasks:
        tid=t.get('id')
        for d in t.get('depends_on',[]):
            deps.append((tid,d))
            if d not in task_ids: dep_bad.append({'task':tid,'dependency':d})
        for x in t.get('test_ids',[]): task_tests.append((tid,x))
        for x in t.get('requirement_ids',[]): task_reqs.append((tid,x))
    for c in coverage:
        rid=c.get('requirement_id')
        for x in c.get('task_ids',[]):
            cov_tasks.append((rid,x))
            if x not in task_ids: cov_task_bad.append({'requirement':rid,'task':x})
        for x in c.get('test_ids',[]):
            cov_tests.append((rid,x))
            if x not in test_ids: cov_test_bad.append({'requirement':rid,'test':x})
    return {'task_count':len(tasks),'unique_task_id_count':len(task_ids),'dependency_edge_count':len(deps),'dependency_dangling':dep_bad,
      'task_test_reference_count':len(task_tests),'unique_task_test_ids':len({x for _,x in task_tests}),
      'task_test_dangling':[{'task':t,'test':x} for t,x in task_tests if x not in test_ids],
      'task_requirement_reference_count':len(task_reqs),'task_requirement_dangling':[{'task':t,'requirement':x} for t,x in task_reqs if x not in req_ids],
      'coverage_count':len(coverage),'unique_coverage_requirement_ids':len({c.get('requirement_id') for c in coverage}),
      'coverage_task_reference_count':len(cov_tasks),'coverage_test_reference_count':len(cov_tests),
