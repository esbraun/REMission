{
  "$defs": {
    "CoverageSlotV2": {
      "additionalProperties": false,
      "properties": {
        "decision_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoint_status": {
          "enum": [
            "not_yet_due",
            "pending",
            "available"
          ],
          "title": "Endpoint Status",
          "type": "string"
        },
        "outcome_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "slot": {
          "$ref": "#/$defs/DecisionSlotV2"
        },
        "status": {
          "enum": [
            "planned",
            "pending",
            "available"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "decision_ref",
        "status",
        "endpoint_status",
        "outcome_ref"
      ],
      "title": "CoverageSlotV2",
      "type": "object"
    },
    "DecisionSlotV2": {
      "additionalProperties": false,
      "properties": {
        "assessment_at": {
          "format": "date-time",
          "title": "Assessment At",
          "type": "string"
        },
        "decision_at": {
          "format": "date-time",
          "title": "Decision At",
          "type": "string"
        },
        "decision_index": {
          "maximum": 84,
          "minimum": 0,
          "title": "Decision Index",
          "type": "integer"
        },
        "outcome_link_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Outcome Link Id",
          "type": "string"
        },
        "window_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Window Id",
          "type": "string"
        }
      },
      "required": [
        "decision_index",
        "decision_at",
        "window_id",
        "assessment_at",
        "outcome_link_id"
      ],
      "title": "DecisionSlotV2",
      "type": "object"
    },
    "ExactRef": {
      "additionalProperties": false,
      "properties": {
        "payload_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "payload_sha256"
      ],
      "title": "ExactRef",
      "type": "object"
    },
    "ScheduleInputV2": {
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "$ref": "#/$defs/VersionRef"
        },
        "cell_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Cell Id",
          "type": "string"
        },
        "cohort_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Cohort Id",
          "type": "string"
        },
        "derivation": {
          "$ref": "#/$defs/VersionRef"
        },
        "dgp": {
          "$ref": "#/$defs/VersionRef"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "support_schedule_input",
          "title": "Kind",
          "type": "string"
        },
        "partition_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Partition Id",
          "type": "string"
        },
        "patient_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Patient Id",
          "type": "string"
        },
        "patient_ref": {
          "$ref": "#/$defs/ExactRef"
        },
        "planned_horizon": {
          "const": 84,
          "title": "Planned Horizon",
          "type": "integer"
        },
        "preset": {
          "enum": [
            "catalog_cell",
            "smoke",
            "demonstration",
            "evaluation"
          ],
          "title": "Preset",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/VersionRef"
        },
        "replicate": {
          "minimum": 0,
          "title": "Replicate",
          "type": "integer"
        },
        "representation": {
          "$ref": "#/$defs/VersionRef"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "temporal": {
          "$ref": "#/$defs/VersionRef"
        },
        "time_zero_local_date": {
          "format": "date",
          "title": "Time Zero Local Date",
          "type": "string"
        },
        "time_zero_utc": {
          "format": "date-time",
          "title": "Time Zero Utc",
          "type": "string"
        },
        "timezone": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "timezone_database": {
          "$ref": "#/$defs/VersionRef"
        },
        "timing": {
          "$ref": "#/$defs/VersionRef"
        },
        "unit_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "synthetic",
        "kind",
        "id",
        "run_id",
        "partition_id",
        "protocol",
        "timing",
        "temporal",
        "representation",
        "dgp",
        "catalog",
        "cell_id",
        "preset",
        "unit_id",
        "cohort_id",
        "replicate",
        "patient_id",
        "patient_ref",
        "timezone",
        "time_zero_local_date",
        "time_zero_utc",
        "timezone_database",
        "derivation",
        "planned_horizon"
      ],
      "title": "ScheduleInputV2",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "urn:remission:runs:2.0.0:support-coverage",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completion_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage_through": {
      "format": "date-time",
      "title": "Coverage Through",
      "type": "string"
    },
    "death_effective_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Death Effective At"
    },
    "death_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "endpoint_status": {
      "enum": [
        "pending",
        "complete"
      ],
      "title": "Endpoint Status",
      "type": "string"
    },
    "execution_status": {
      "enum": [
        "partial",
        "complete"
      ],
      "title": "Execution Status",
      "type": "string"
    },
    "expected_decisions": {
      "items": {
        "$ref": "#/$defs/DecisionSlotV2"
      },
      "title": "Expected Decisions",
      "type": "array"
    },
    "first_decision_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "First Decision At"
    },
    "first_decision_index": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "First Decision Index"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "support_coverage",
      "title": "Kind",
      "type": "string"
    },
    "last_decision_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Decision At"
    },
    "last_decision_index": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Decision Index"
    },
    "no_terminal_event_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_cutoff": {
      "format": "date-time",
      "title": "Receipt Cutoff",
      "type": "string"
    },
    "run_manifest": {
      "$ref": "#/$defs/VersionRef"
    },
    "schedule": {
      "$ref": "#/$defs/ScheduleInputV2"
    },
    "schedule_input": {
      "$ref": "#/$defs/VersionRef"
    },
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slots": {
      "items": {
        "$ref": "#/$defs/CoverageSlotV2"
      },
      "title": "Slots",
      "type": "array"
    },
    "status": {
      "enum": [
        "partial",
        "complete"
      ],
      "title": "Status",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "terminal_phase": {
      "anyOf": [
        {
          "const": "safety_before_decision",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Terminal Phase"
    },
    "terminal_reconciliation": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "kind",
    "id",
    "run_manifest",
    "schedule_input",
    "schedule",
    "expected_decisions",
    "first_decision_index",
    "last_decision_index",
    "first_decision_at",
    "last_decision_at",
    "receipt_cutoff",
    "coverage_through",
    "status",
    "execution_status",
    "endpoint_status",
    "slots",
    "death_ref",
    "death_effective_at",
    "terminal_phase",
    "terminal_reconciliation",
    "no_terminal_event_evidence",
    "completion_receipt"
  ],
  "title": "SupportCoverageV2",
  "type": "object"
}
