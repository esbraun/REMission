{
  "$defs": {
    "Clearance": {
      "additionalProperties": false,
      "properties": {
        "assessment_snapshot_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ExactRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "not_applicable",
            "pending",
            "documented"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "rule",
        "evidence_refs",
        "assessment_snapshot_ref"
      ],
      "title": "Clearance",
      "type": "object"
    },
    "EvidenceRole": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/ExactRef"
        },
        "role": {
          "enum": [
            "causal_context",
            "transition_trigger",
            "later_review"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "role"
      ],
      "title": "EvidenceRole",
      "type": "object"
    },
    "ExactRef": {
      "additionalProperties": false,
      "properties": {
        "payload_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "record_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "payload_sha256"
      ],
      "title": "ExactRef",
      "type": "object"
    },
    "RequiredReview": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/VersionRef"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ExactRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "requirement_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "responsible_role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Responsible Role",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "satisfied"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "definition",
        "responsible_role",
        "status",
        "evidence_refs"
      ],
      "title": "RequiredReview",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "enum": [
            "synthetic_fhir_shaped",
            "synthetic_oura_like",
            "patient_report",
            "synthetic_trial",
            "simulation",
            "research_configuration"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "adapter",
        "raw_sha256"
      ],
      "title": "Source",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "$id": "urn:remission:domain:2.0.0:hold-transition-bundle",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "blocked_actions": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
        "type": "string"
      },
      "title": "Blocked Actions",
      "type": "array"
    },
    "causal_context_refs": {
      "items": {
        "$ref": "#/$defs/ExactRef"
      },
      "title": "Causal Context Refs",
      "type": "array"
    },
    "changed_fact_refs": {
      "items": {
        "$ref": "#/$defs/ExactRef"
      },
      "title": "Changed Fact Refs",
      "type": "array"
    },
    "clearance": {
      "$ref": "#/$defs/Clearance"
    },
    "context_cutoff": {
      "format": "date-time",
      "title": "Context Cutoff",
      "type": "string"
    },
    "context_projection_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Context Projection Sha256",
      "type": "string"
    },
    "duplicate_of": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Duplicate Of"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "eligibility_configuration": {
      "$ref": "#/$defs/VersionRef"
    },
    "event_at": {
      "format": "date-time",
      "title": "Event At",
      "type": "string"
    },
    "evidence_roles": {
      "items": {
        "$ref": "#/$defs/EvidenceRole"
      },
      "title": "Evidence Roles",
      "type": "array"
    },
    "follow_up_refs": {
      "items": {
        "$ref": "#/$defs/ExactRef"
      },
      "minItems": 1,
      "title": "Follow Up Refs",
      "type": "array"
    },
    "hold_episode_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Hold Episode Id",
      "type": "string"
    },
    "kind": {
      "const": "hold_transition_bundle",
      "title": "Kind",
      "type": "string"
    },
    "lineage_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Lineage Id",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/VersionRef"
    },
    "owner_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Owner Id",
      "type": "string"
    },
    "owner_role": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Role",
      "type": "string"
    },
    "ownership_ref": {
      "$ref": "#/$defs/ExactRef"
    },
    "partition_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Partition Id",
      "type": "string"
    },
    "patient_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Patient Id",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/VersionRef"
    },
    "predecessor_bundle_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "predecessor_snapshot_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_status": {
      "enum": [
        "active",
        "corrected",
        "retracted"
      ],
      "title": "Record Status",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "required_reviews": {
      "items": {
        "$ref": "#/$defs/RequiredReview"
      },
      "title": "Required Reviews",
      "type": "array"
    },
    "review_refs": {
      "items": {
        "$ref": "#/$defs/ExactRef"
      },
      "title": "Review Refs",
      "type": "array"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_ref": {
      "$ref": "#/$defs/ExactRef"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "supersedes": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supersedes"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "transition_sequence": {
      "minimum": 0,
      "title": "Transition Sequence",
      "type": "integer"
    },
    "transition_type": {
      "enum": [
        "baseline",
        "enter",
        "change_reason",
        "resolve_to_assessment"
      ],
      "title": "Transition Type",
      "type": "string"
    },
    "trigger_refs": {
      "items": {
        "$ref": "#/$defs/ExactRef"
      },
      "title": "Trigger Refs",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "record_id",
    "patient_id",
    "event_at",
    "recorded_at",
    "available_at",
    "source",
    "lineage_id",
    "revision",
    "supersedes",
    "duplicate_of",
    "record_status",
    "kind",
    "run_id",
    "partition_id",
    "hold_episode_id",
    "transition_sequence",
    "transition_type",
    "effective_at",
    "snapshot_ref",
    "predecessor_bundle_ref",
    "predecessor_snapshot_ref",
    "reason_codes",
    "reason",
    "trigger_refs",
    "changed_fact_refs",
    "blocked_actions",
    "context_cutoff",
    "causal_context_refs",
    "context_projection_sha256",
    "policy",
    "model",
    "eligibility_configuration",
    "owner_id",
    "owner_role",
    "ownership_ref",
    "follow_up_refs",
    "required_reviews",
    "review_refs",
    "clearance",
    "evidence_roles"
  ],
  "title": "HoldTransitionBundleV2",
  "type": "object"
}
