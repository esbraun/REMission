  grant.trigger_bindings[0].follow_ups.append(grant.trigger_bindings[1].follow_ups[0]);self.install_next(authority);self.restart_client()
  before=self.safety_state();r=self.client.post('/api/patients/SYN-02/live-holds',json=self.command,headers=self.headers('independent-omission'))
  print('mandatory-subset',r.status_code,r.text,flush=True);self.assertEqual(r.status_code,409);self.assertEqual(r.json()['code'],'hold_follow_up_mismatch');self.assertEqual(self.safety_state(),before)
 def test_full_control(self):
