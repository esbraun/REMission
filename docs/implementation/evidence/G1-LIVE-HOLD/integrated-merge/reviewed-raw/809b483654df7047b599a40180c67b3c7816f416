class Upgrade(StoppedUpgradeTests):
 def test_independent_rollback_and_preservation(self):
  def snapshot(path):
   with closing(sqlite3.connect(path)) as db:
    tables=[r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")]
    return {t:db.execute('SELECT * FROM "'+t+'" ORDER BY rowid').fetchall() for t in tables}
  original=snapshot(self.source)
  def fail(point):
   if point=='before_004_upgrade_commit':raise RuntimeError('independent-beforecommit')
  with self.assertRaisesRegex(RuntimeError,'independent-beforecommit'):upgrade_checkpoint003(self.target,self.source,self.previous,self.new,clock=lambda:NOW,fault=fail)
  self.assertEqual(snapshot(self.source),original);self.assertEqual(snapshot(self.target),original)
  print('beforecommit rollback: every table/row equals actual003 source including control, patient, episode and review',flush=True)
  good=self.root/'independent-success.sqlite';store=upgrade_checkpoint003(good,self.source,self.previous,self.new,clock=lambda:NOW)
  after=snapshot(good);self.assertEqual(snapshot(self.source),original)
  for t in ['live_hold_tasks','live_hold_reviews','live_hold_operations','observed_archives','observed_archive_entries','decisions','receipts','bundles']:
   self.assertEqual(after[t][:len(original[t])],original[t],t)
  with store.transaction() as db:
   self.assertEqual(db.execute('PRAGMA foreign_key_check').fetchall(),[])
   self.assertEqual(db.execute('SELECT count(*) FROM live_hold_task_bindings').fetchone()[0],1)
  print('successful private copy: named history/raw/task prefixes byte equal; FK clean; one preserved anchor mapping',flush=True)
suite=unittest.TestSuite([Admission('test_subset_and_full'),Admission('test_full_control'),Pass2('test_receipt_history'),Pass2('test_plural_clearance_isolation'),StoppedUpgradeTests('test_actual003_upgrade_preserves_old_bytes_ids_and_invalidates_review_once'),StoppedUpgradeTests('test_actual_process_death_before004_commit_rolls_back_and_after_commit_recovers'),Upgrade('test_independent_rollback_and_preservation')])
raise SystemExit(not unittest.TextTestRunner(verbosity=2).run(suite).wasSuccessful())
