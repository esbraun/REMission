 raw=p.read_bytes();blob=subprocess.check_output(['git','hash-object','-w','--no-filters',str(p)],cwd=root).decode().strip()
 files[p.relative_to(out).as_posix()]={'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'git_blob':blob}
 if p.name=='command.json':commands.append({'path':p.relative_to(out).as_posix(),**json.loads(raw)})
