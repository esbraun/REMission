{
  "Args": [
    "-ec",
    "file_caps=\"$(getcap /usr/bin/caddy)\"\n[ \"$file_caps\" = \"/usr/bin/caddy cap_net_bind_service=ep\" ]\nprintf '%s\\n' \"$file_caps\"\nawk '\n$1 == \"Uid:\" || $1 == \"Gid:\" {\n  if (NF != 5 || $2 != \"0\" || $3 != \"0\" || $4 != \"0\" || $5 != \"0\") exit 1\n  print $1, $2, $3, $4, $5; count++; next\n}\n$1 == \"CapPrm:\" || $1 == \"CapEff:\" || $1 == \"CapBnd:\" {\n  if (NF != 2 || $2 != \"0000000000000400\") exit 1\n  print $1, $2; count++; next\n}\n$1 == \"NoNewPrivs:\" {\n  if (NF != 2 || $2 != \"1\") exit 1\n  print $1, $2; count++\n}\nEND { if (count != 6) exit 1 }\n' /proc/$$/status\ncaddy version\ncaddy validate --config /inputs/ipv4.Caddyfile --adapter caddyfile 1>&2\necho REMISSION_IPV4_VALIDATED\ncaddy validate --config /inputs/dns.Caddyfile --adapter caddyfile 1>&2\necho REMISSION_DNS_VALIDATED\n"
  ],
