        "generator_image": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Generator Image",
          "type": "string"
        },
        "generator_source_closure": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
