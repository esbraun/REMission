          },
          "title": "Generator Source Closure",
          "type": "object"
        },
        "installed_bundle_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Installed Bundle Sha256",
          "type": "string"
        },
        "invocation_class": {
          "const": "owned-interactive-support-v1",
          "title": "Invocation Class",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/VersionRef"
        },
        "schema_version": {
          "const": "poc-support-interactive-packet-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "store_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Store Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "app_commit",
        "app_source_closure",
        "generator_source_closure",
        "app_image",
        "generator_image",
        "runtime",
